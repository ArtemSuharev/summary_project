# Yandex GPT configuration
LLM_BASE_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
LLM_MODEL=gpt://<folder-id>/yandexgpt/latest
LLM_KEY_ID=your-key-id-here
LLM_KEY_SECRET=your-key-secret-here
LLM_TIMEOUT=60

# Server configuration
HOST=0.0.0.0
PORT=8000
MAX_TEXT_LENGTH=50000

# Fallback (возвращается при недоступности LLM)
FALLBACK_ENABLED=true
FALLBACK_SUMMARY=Сервис суммаризации временно недоступен. Повторите запрос позже.

# Logging
LOG_LEVEL=info
